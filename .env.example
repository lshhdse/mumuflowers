# AI service defaults to loopback. For a phone, use a TLS reverse proxy.
HOST=127.0.0.1
PORT=8787
# Choose a long random token. If empty, a token is generated in server/data/access-token.
MUMU_ACCESS_TOKEN=
# Use a stable 64-hex-character key when deploying; otherwise one is generated locally.
MUMU_ENCRYPTION_KEY=
MUMU_DATA_DIR=server/data
MUMU_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787,https://localhost,http://localhost
# For local model servers ONLY. HTTPS is required for other AI endpoints.
MUMU_ALLOW_LOCAL_AI_HTTP=false
